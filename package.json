{
  "name": "hearthguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "test": "node scripts/build-server.mjs && vitest run",
    "test:browser": "playwright test",
    "start": "node dist-server/index.mjs",
    "simulate": "tsx scripts/simulate.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.4"
  }
}
